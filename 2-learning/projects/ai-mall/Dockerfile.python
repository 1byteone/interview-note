# =============================================================================
# Dockerfile.python — Python FastAPI 服务多阶段构建
#
# 使用方式（在 docker-compose.yml 中）:
#   build:
#     context: .
#     dockerfile: Dockerfile.python
#     args:
#       SERVICE_NAME: ai-search-service
#
# 阶段一(builder): 安装 Python 依赖（利用 pip 缓存层加速）
# 阶段二(runtime): 精简运行环境，以非 root 用户运行
# =============================================================================

# ---------------------------------------------------------------------------
# 阶段 1：构建阶段 — 安装 Python 依赖
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS builder

ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME:-ai-service}

# 设置使用非交互模式和国内镜像源（可自行修改）
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Shanghai

# 工作目录
WORKDIR /build

# 先拷贝依赖声明文件，利用 Docker 层缓存
COPY requirements.txt ./

# 安装依赖
RUN pip install --no-cache-dir -r requirements.txt

# 拷贝源码（app 目录为 FastAPI 应用代码）
COPY app/ ./app/

# ---------------------------------------------------------------------------
# 阶段 2：运行阶段 — 精简运行环境
# ---------------------------------------------------------------------------
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8 \
    TZ=Asia/Shanghai

# 创建非 root 用户
RUN useradd --create-home --shell /bin/bash mall

WORKDIR /app

# 从构建阶段拷贝依赖与源码
COPY --from=builder /usr/local/lib/python3.11/site-packages/ /usr/local/lib/python3.11/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/
COPY --from=builder /build/app/ /app/

# 切换为非 root 用户
USER mall

# 暴露服务端口（实际端口由各服务 docker-compose 配置决定）
EXPOSE 8085

# 启动命令：uvicorn 运行 FastAPI 应用
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8085", "--workers", "2"]